---
Checks: >
  *,
  -altera-unroll-loops,
  -cppcoreguidelines-avoid-magic-numbers,
  -llvmlibc-restrict-system-libc-headers,
  -readability-magic-numbers
WarningsAsErrors: "*"
HeaderFileExtensions:
  - ""
  - h
  - hh
  - hpp
  - hxx
ImplementationFileExtensions:
  - c
  - cc
  - cpp
  - cxx
HeaderFilterRegex: "*"
