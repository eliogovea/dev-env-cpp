  "testPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "output": {
        "verbosity": "extra"
      }
    },
    {
      "name": "clang-debug-sanitize-address",
      "configurePreset": "clang-debug-sanitize-address",
      "output": {
        "verbosity": "extra"
      },
      "environment": {
        "ASAN_OPTIONS": "debug=1:verbosity=2:detect_stack_use_after_return=1"
      }
    },
    {
      "name": "clang-debug-sanitize-memory",
      "configurePreset": "clang-debug-sanitize-memory",
      "output": {
        "verbosity": "extra"
